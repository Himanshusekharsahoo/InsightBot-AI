# =============================================================================
# InsightBot AI — Environment Configuration Template
# Copy this file to .env and configure values for your local environment:
#   cp .env.example .env
# Validate your configuration anytime by running:
#   uv run insightbot preflight
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Deployment Mode
# -----------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
# In development: single-tenant unauthenticated local access is permitted.
# In production: INSIGHTBOT_API_KEY (>=16 chars) is strictly enforced,
#                mock providers are prohibited, and CORS origins are restricted.
INSIGHTBOT_ENV=development

# Allowed CORS origins for the FastAPI backend (comma-separated).
# Include your Next.js frontend address (http://localhost:3000).
INSIGHTBOT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# API Authentication Key (Optional in local development; required in production)
# In development, leave blank for open local access or set a test key.
# In production, this MUST be a strong secret with at least 16 characters.
# INSIGHTBOT_API_KEY=your_development_api_key_here

# Multi-Tenancy & Workspace Authorization (Optional)
# INSIGHTBOT_MULTI_TENANCY_ENABLED=false
# INSIGHTBOT_DEFAULT_ORGANIZATION_ID=default
# INSIGHTBOT_TENANT_API_KEYS=org_alpha:key_alpha_secret_16chars,org_beta:key_beta_secret_16chars

# -----------------------------------------------------------------------------
# 2. Database & Vector Storage Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (asyncpg format)
# NOTE: 'postgres:postgres@localhost:5432' is a local development default example only.
# In production, replace with appropriately secured database credentials, TLS parameters, and hostnames.
INSIGHTBOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightbot

# Storage Mode:
#   auto: Detects pgvector extension; if absent, transparently uses PostgreSQL float8[] arrays (pg_array)
#   native: Strict mode requiring native pgvector extension (raises error if missing)
#   array: Always store vectors in PostgreSQL float8[] array columns with Cosine dot-product
#   in_memory: Ephemeral memory-only vector storage (development/offline testing only; forbidden in production)
INSIGHTBOT_VECTOR_STORE_MODE=auto

# Minimum similarity threshold for grounded evidence chunks (range: 0.0 - 1.0)
INSIGHTBOT_MIN_SIMILARITY_SCORE=0.2

# -----------------------------------------------------------------------------
# 3. AI Synthesis & Embedding Provider Configuration
# -----------------------------------------------------------------------------
# Supported providers: 'google', 'openai', 'mock'

# --- OPTION A: Google Gemini (Recommended & Verified Default) ---
INSIGHTBOT_LLM_PROVIDER=google
INSIGHTBOT_LLM_MODEL=gemini-flash-latest
INSIGHTBOT_EMBEDDING_PROVIDER=google
INSIGHTBOT_EMBEDDING_MODEL=gemini-embedding-001
INSIGHTBOT_EMBEDDING_DIM=768
GOOGLE_API_KEY=your_google_api_key_here

# --- OPTION B: OpenAI (Alternative Real Provider) ---
# INSIGHTBOT_LLM_PROVIDER=openai
# INSIGHTBOT_LLM_MODEL=gpt-4o-mini
# INSIGHTBOT_EMBEDDING_PROVIDER=openai
# INSIGHTBOT_EMBEDDING_MODEL=text-embedding-3-small
# INSIGHTBOT_EMBEDDING_DIM=1536
# OPENAI_API_KEY=your_openai_api_key_here

# --- OPTION C: Mock Provider (Offline Development & CI Testing) ---
# Generates deterministic synthetic grounded answers without external API calls or costs.
# INSIGHTBOT_LLM_PROVIDER=mock
# INSIGHTBOT_EMBEDDING_PROVIDER=mock
# INSIGHTBOT_VECTOR_STORE_MODE=in_memory

# External AI API Timeout in seconds
INSIGHTBOT_AI_TIMEOUT=30.0

# Maximum concurrent in-flight AI requests per process
INSIGHTBOT_AI_MAX_CONCURRENT_REQUESTS=10

# -----------------------------------------------------------------------------
# 4. Text Chunking & Ingestion Limits
# -----------------------------------------------------------------------------
INSIGHTBOT_CHUNK_SIZE=1000
INSIGHTBOT_CHUNK_OVERLAP=200

# Maximum document upload size in bytes (default: 20MB = 20971520)
INSIGHTBOT_MAX_UPLOAD_SIZE=20971520

# -----------------------------------------------------------------------------
# 5. Autonomous Browser Research Engine (Optional)
# -----------------------------------------------------------------------------
# Disabled by default for local development security.
INSIGHTBOT_BROWSER_ENABLED=false
INSIGHTBOT_BROWSER_HEADLESS=true
INSIGHTBOT_BROWSER_USE_CLOUD=false

# -----------------------------------------------------------------------------
# 6. Logging & Telemetry
# -----------------------------------------------------------------------------
# Logging level: debug, info, warning, error
INSIGHTBOT_LOGGING_LEVEL=info
CDP_LOGGING_LEVEL=WARNING
INSIGHTBOT_TELEMETRY=false
INSIGHTBOT_VERSION_CHECK=false
